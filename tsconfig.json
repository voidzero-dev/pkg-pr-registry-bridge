{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["void/env"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "routes", "crons", "env.ts", "test", "vite.config.ts", "vitest.config.ts"],
  // The action tests run in Node, not the Worker: tsconfig.action.json checks
  // them (and the action source) against Node types.
  "exclude": ["test/action"]
}
