# Public local defaults. Copy this file to the gitignored root .env for development.
# Add local credentials only to .env. Void never uploads .env during deployment.
PUBLIC_BASE_URL=http://localhost:5173
NPM_REGISTRY=https://registry.npmjs.org
PREVIEW_OWNER=voidzero-dev
PREVIEW_REPO=vite-plus
WORKSPACE_PACKAGES=vite-plus,@voidzero-dev/vite-plus-*
