{
  "name": "pkg-pr-registry-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Version-gated npm registry bridge for pkg.pr.new Vite+ preview builds, running on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy && node scripts/warm.mjs && node scripts/e2e-bun.mjs",
    "deploy:only": "wrangler deploy",
    "warm": "node scripts/warm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-bun.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "hono": "^4.12.27",
    "nanotar": "^0.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@cloudflare/workers-types": "^4.20260626.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.105.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  }
}
