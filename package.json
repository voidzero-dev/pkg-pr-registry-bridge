{
  "name": "pkg-pr-registry-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Version-gated npm registry bridge for pkg.pr.new Vite+ preview builds, running on Cloudflare Workers",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "prepare": "void prepare",
    "deploy": "void deploy && node scripts/e2e-bun.mjs",
    "deploy:only": "void deploy",
    "warm": "node scripts/warm.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "deploy:staging": "void deploy --project pkg-pr-registry-bridge-staging",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.action.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-bun.mjs",
    "build:action": "node scripts/build-action.mjs"
  },
  "dependencies": {
    "hono": "^4.12.27",
    "nanotar": "^0.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@types/node": "^24.13.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.0",
    "void": "^0.10.5",
    "wrangler": "^4.105.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  }
}
