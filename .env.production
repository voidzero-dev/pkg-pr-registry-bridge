# Committed production overrides for `void deploy`. Only the host-specific
# origin differs from `.env`; everything else is inherited. Secrets (ADMIN_TOKEN,
# GITHUB_TOKEN) are NOT here, they are uploaded with `void secret put`.

# Public origin of the deployed bridge (the Void platform URL). Update this if a
# custom domain is later attached with `void domain add`.
PUBLIC_BASE_URL=https://pkg-pr-registry-bridge.void.app
